@page "/catalog"
@using HairSalon.DTOs
@using Microsoft.EntityFrameworkCore
@inject HairSalon.Data.HairSalonContext Context
@inject IMasterService MasterService
@inject IServiceService ServiceService
@inject NavigationManager Navigation

<div class="container mt-4">
    <!-- Заголовок -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-store text-primary me-2"></i>Наш каталог
        </h1>
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/")'>
            <i class="fas fa-arrow-left me-1"></i>На главную
        </button>
    </div>

    <!-- Вкладки -->
    <ul class="nav nav-tabs mb-4" style="border-bottom-color: #2a2f3a;">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "services" ? "active" : "")"
                    style="color: @(activeTab == "services" ? "#667eea" : "#e0e0e0"); background-color: @(activeTab == "services" ? "#1a1f2a" : "transparent");"
                    @onclick='() => SetActiveTab("services")'>
                <i class="fas fa-cut me-2"></i>Услуги
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "masters" ? "active" : "")"
                    style="color: @(activeTab == "masters" ? "#667eea" : "#e0e0e0"); background-color: @(activeTab == "masters" ? "#1a1f2a" : "transparent");"
                    @onclick='() => SetActiveTab("masters")'>
                <i class="fas fa-users me-2"></i>Мастера
            </button>
        </li>
    </ul>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Услуги -->
        @if (activeTab == "services")
        {
            <div class="row g-4">
                <!-- Фильтр услуг -->
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4 mb-4" style="background-color: #151922;">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input type="text" class="form-control" placeholder="Поиск по названию услуги..."
                                           @bind="serviceSearchText" @bind:event="oninput" @bind:after="FilterServices" />
                                </div>
                                <div class="col-md-6">
                                    <select class="form-select" @bind="servicePriceFilter" @bind:after="FilterServices">
                                        <option value="all">Все цены</option>
                                        <option value="0-1000">До 1000 ₽</option>
                                        <option value="1000-2000">1000 - 2000 ₽</option>
                                        <option value="2000-5000">2000 - 5000 ₽</option>
                                        <option value="5000+">От 5000 ₽</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Результаты -->
                @if (!_filteredServices.Any())
                {
                    <div class="col-12">
                        <div class="text-center p-5">
                            <i class="fas fa-search fa-4x text-white-50 mb-3"></i>
                            <h4 class="text-white">Ничего не найдено</h4>
                            <p class="text-white-50">Попробуйте изменить параметры поиска</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var service in _filteredServices)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="service-card card shadow-sm border-0 rounded-4 h-100" style="background: linear-gradient(135deg, #1a1f2a 0%, #151922 100%);">
                                <div class="card-body p-4">
                                    <div class="service-icon mb-3">
                                        @if (service.Name.Contains("Стрижка"))
                                        {
                                            <i class="fas fa-cut fa-2x text-primary"></i>
                                        }
                                        else if (service.Name.Contains("Окрашивание") || service.Name.Contains("Color"))
                                        {
                                            <i class="fas fa-palette fa-2x text-primary"></i>
                                        }
                                        else if (service.Name.Contains("Маникюр"))
                                        {
                                            <i class="fas fa-hand-sparkles fa-2x text-primary"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-spa fa-2x text-primary"></i>
                                        }
                                    </div>
                                    <h5 class="card-title text-white">@service.Name</h5>
                                    <p class="card-text text-white-50 small">
                                        @(service.Description?.Length > 100 ? service.Description.Substring(0, 100) + "..." : service.Description ?? "Нет описания")
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="price-tag h4 mb-0 text-primary">@service.Price.ToString("N0") ₽</span>
                                        <a href="/booking" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-calendar-alt me-1"></i>Записаться
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                @if (_filteredServices.Any())
                {
                    <div class="col-12 text-center mt-3">
                        <p class="text-white-50 small">
                            Показано @_filteredServices.Count из @_services.Count услуг
                        </p>
                    </div>
                }
            </div>
        }

        <!-- Мастера -->
        @if (activeTab == "masters")
        {
            <div class="row g-4">
                <!-- Фильтр мастеров -->
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4 mb-4" style="background-color: #151922;">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <input type="text" class="form-control" placeholder="Поиск по имени..."
                                           @bind="masterSearchText" @bind:event="oninput" @bind:after="FilterMasters" />
                                </div>
                                <div class="col-md-4">
                                    <select class="form-select" @bind="masterGenderFilter" @bind:after="FilterMasters">
                                        <option value="all">Все мастера</option>
                                        <option value="М">Мужской</option>
                                        <option value="Ж">Женский</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select class="form-select" @bind="masterSortBy" @bind:after="FilterMasters">
                                        <option value="name">По имени</option>
                                        <option value="experience">По опыту (возрастание)</option>
                                        <option value="experience_desc">По опыту (убывание)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!_filteredMasters.Any())
                {
                    <div class="col-12">
                        <div class="text-center p-5">
                            <i class="fas fa-search fa-4x text-white-50 mb-3"></i>
                            <h4 class="text-white">Ничего не найдено</h4>
                            <p class="text-white-50">Попробуйте изменить параметры поиска</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var master in _filteredMasters)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="master-card card shadow-sm border-0 rounded-4 h-100 text-center" style="background: linear-gradient(135deg, #1a1f2a 0%, #151922 100%);">
                                <div class="card-body p-4">
                                    <div class="master-avatar mx-auto mb-3">
                                        <div class="avatar-circle d-flex align-items-center justify-content-center rounded-circle mx-auto"
                                             style="width: 100px; height: 100px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                            <span class="display-4 fw-bold text-white">@(master.FirstName[0])@(master.LastName[0])</span>
                                        </div>
                                    </div>
                                    <h5 class="mb-1 text-white">@master.FirstName @master.LastName</h5>
                                    <p class="text-white-50 small mb-2">
                                        <i class="fas fa-gender-@(master.Gender == "М" ? "mars" : "venus") me-1"></i>
                                        @(master.Gender == "М" ? "Мужской" : "Женский")
                                    </p>
                                    <div class="rating mb-2">
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star text-warning"></i>
                                        <i class="fas fa-star-half-alt text-warning"></i>
                                    </div>
                                    <p class="experience-text small text-white-50">
                                        <i class="fas fa-briefcase me-1"></i>Опыт: @master.Experience
                                    </p>
                                    @if (!string.IsNullOrEmpty(master.Description))
                                    {
                                        <p class="small text-white-50 mt-2">
                                            <i class="fas fa-comment me-1"></i>@(master.Description.Length > 80 ? master.Description.Substring(0, 80) + "..." : master.Description)
                                        </p>
                                    }
                                    <a href="/booking" class="btn btn-sm btn-outline-primary mt-3 w-100">
                                        <i class="fas fa-calendar-alt me-2"></i>Записаться
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }

                @if (_filteredMasters.Any())
                {
                    <div class="col-12 text-center mt-3">
                        <p class="text-white-50 small">
                            Показано @_filteredMasters.Count из @_masters.Count мастеров
                        </p>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .service-card, .master-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #2a2f3a;
    }

        .service-card:hover, .master-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
            border-color: #667eea;
        }

    .service-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(102, 126, 234, 0.1);
        border-radius: 12px;
    }

    .price-tag {
        font-weight: bold;
        color: #667eea;
    }

    .avatar-circle {
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    .nav-tabs .nav-link {
        background: none;
        border: none;
        padding: 10px 20px;
        font-weight: 500;
    }

        .nav-tabs .nav-link.active {
            border-bottom: 2px solid #667eea;
            font-weight: bold;
        }

        .nav-tabs .nav-link:hover:not(.active) {
            color: #667eea;
        }

    .form-control, .form-select {
        background-color: #1a1f2a !important;
        color: #e0e0e0 !important;
        border: 1px solid #2a2f3a !important;
        border-radius: 8px !important;
        padding: 10px 12px !important;
    }

        .form-control:focus, .form-select:focus {
            border-color: #667eea !important;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25) !important;
            outline: none !important;
        }

        .form-select option {
            background-color: #1a1f2a;
            color: #e0e0e0;
        }

    .btn-outline-primary {
        border-color: #667eea;
        color: #667eea;
    }

        .btn-outline-primary:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: transparent;
            color: white;
        }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .rating {
        font-size: 0.8rem;
    }

    ::-webkit-calendar-picker-indicator {
        filter: invert(1);
        cursor: pointer;
    }
</style>

@code {
    private string activeTab = "services";

    private List<ServiceDto> _services = new();
    private List<ServiceDto> _filteredServices = new();
    private List<MasterDto> _masters = new();
    private List<MasterDto> _filteredMasters = new();

    private bool _isLoading = true;

    // Фильтры для услуг
    private string serviceSearchText = string.Empty;
    private string servicePriceFilter = "all";

    // Фильтры для мастеров
    private string masterSearchText = string.Empty;
    private string masterGenderFilter = "all";
    private string masterSortBy = "name";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            // Загрузка услуг через сервис
            var servicesFromDb = await Context.Services.ToListAsync();
            _services = (await ServiceService.GetFormattedServicesForAdminAsync(servicesFromDb)).ToList();
            _filteredServices = _services.ToList();

            // Загрузка мастеров через сервис
            var mastersFromDb = await Context.Masters.Include(m => m.User).ToListAsync();
            _masters = (await MasterService.GetFormattedMastersAsync(mastersFromDb)).ToList();
            _filteredMasters = _masters.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private void FilterServices()
    {
        var filtered = _services.AsEnumerable();

        // Поиск по названию
        if (!string.IsNullOrWhiteSpace(serviceSearchText))
        {
            filtered = filtered.Where(s => s.Name.Contains(serviceSearchText, StringComparison.OrdinalIgnoreCase));
        }

        // Фильтр по цене
        if (servicePriceFilter != "all")
        {
            if (servicePriceFilter == "0-1000")
                filtered = filtered.Where(s => s.Price <= 1000);
            else if (servicePriceFilter == "1000-2000")
                filtered = filtered.Where(s => s.Price > 1000 && s.Price <= 2000);
            else if (servicePriceFilter == "2000-5000")
                filtered = filtered.Where(s => s.Price > 2000 && s.Price <= 5000);
            else if (servicePriceFilter == "5000+")
                filtered = filtered.Where(s => s.Price > 5000);
        }

        _filteredServices = filtered.ToList();
        StateHasChanged();
    }

    private void FilterMasters()
    {
        var filtered = _masters.AsEnumerable();

        // Поиск по имени
        if (!string.IsNullOrWhiteSpace(masterSearchText))
        {
            filtered = filtered.Where(m =>
                m.FirstName.Contains(masterSearchText, StringComparison.OrdinalIgnoreCase) ||
                m.LastName.Contains(masterSearchText, StringComparison.OrdinalIgnoreCase));
        }

        // Фильтр по полу
        if (masterGenderFilter != "all")
        {
            filtered = filtered.Where(m => m.Gender == masterGenderFilter);
        }

        // Сортировка
        if (masterSortBy == "name")
            filtered = filtered.OrderBy(m => m.FirstName);
        else if (masterSortBy == "experience")
            filtered = filtered.OrderBy(m => m.Experience);
        else if (masterSortBy == "experience_desc")
            filtered = filtered.OrderByDescending(m => m.Experience);

        _filteredMasters = filtered.ToList();
        StateHasChanged();
    }
}